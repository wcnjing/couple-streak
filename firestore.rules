rules_version = '2';

// Only Wen Jing and Javen can read check-ins, and each can only add or remove their own.
// Replace the two emails below with the Google accounts you sign in with
// (the same ones as in public/firebase-config.js).
service cloud.firestore {
  match /databases/{database}/documents {
    function me() {
      return request.auth != null && request.auth.token.email_verified == true
        ? {
            "WENJING_EMAIL@example.com": "wenjing",
            "JAVEN_EMAIL@example.com": "javen"
          }.get(request.auth.token.email.lower(), null)
        : null;
    }

    function validCheckin(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(["person", "date", "at"])
        && d.person == me()
        && d.date is string
        && d.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && d.at is string
        && id == d.person + "_" + d.date;
    }

    match /checkins/{id} {
      allow read: if me() != null;
      allow create, update: if me() != null && validCheckin(id);
      allow delete: if me() != null && resource.data.person == me();
    }
  }
}
